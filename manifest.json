{
  "manifest_version": 3,
  "name": "Grade 4 Perfect AdBlocker",
  "version": "1.0.1",
  "description": "Chrome 확장프로그램 기반의 강력한 광고 차단 도구입니다.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
